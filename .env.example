# Copie para .env se quiser customizar (todos tem default sensato no codigo)
PORT=3000

# Timeout por chamada a cada provider externo. Se um provider demorar mais
# que isso, tratamos como falha e fazemos failover pro proximo (nao esperamos
# os 30s do pior caso: isso degradaria nosso proprio SLA).
PROVIDER_TIMEOUT_MS=5000

# Circuit breaker por provider: depois de N falhas tecnicas consecutivas,
# o provider fica "aberto" (nao tentamos mais ele) por COOLDOWN_MS,
# evitando desperdicar tempo tentando um provider que sabemos que esta fora.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_MS=30000

VIACEP_BASE_URL=https://viacep.com.br/ws
BRASILAPI_BASE_URL=https://brasilapi.com.br/api/cep/v1

# --- Extra: POST /webhooks/cep-batch (consulta em lote + callback assincrono) ---
# Quantas vezes tentamos entregar o resultado no webhookUrl do cliente
# antes de desistir e marcar o job como dead_letter.
WEBHOOK_MAX_ATTEMPTS=5
# Base do backoff exponencial entre tentativas de entrega (1a=1s, 2a=2s, 3a=4s...).
WEBHOOK_BACKOFF_BASE_MS=1000

# --- Drivers de fila e persistencia (opcional, ambos default = memoria) ---
# Sem Redis/MySQL disponiveis? Deixe tudo comentado/como esta: o projeto
# roda 100% com "npm install && npm run start:dev", sem infra nenhuma.
#
# QUEUE_DRIVER=memory (default) | bullmq
#   memory: fila em processo, concorrencia 1, zero infra.
#   bullmq: fila real (BullMQ + Redis) - sobrevive a reinicio do processo.
#           Requer REDIS_HOST/REDIS_PORT com um Redis de verdade rodando.
QUEUE_DRIVER=memory
REDIS_HOST=localhost
REDIS_PORT=6379

# DB_DRIVER=memory (default) | mysql
#   memory: Map em processo, zero infra.
#   mysql: persiste os batch jobs numa tabela MySQL de verdade (ver
#          src/webhook/repository/schema.sql pro CREATE TABLE).
#          Requer as variaveis MYSQL_* abaixo com um MySQL de verdade rodando.
DB_DRIVER=memory
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=teste_dev
